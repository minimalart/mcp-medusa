MEDUSA_BASE_URL=http://localhost:9000

# Medusa Admin authentication.
# api-key: Authorization: Basic <MEDUSA_API_KEY>
# jwt: Authorization: Bearer <MEDUSA_JWT or MEDUSA_API_KEY>
# session: Cookie: <MEDUSA_SESSION_COOKIE>
MEDUSA_AUTH_TYPE=api-key
MEDUSA_API_KEY=your_admin_api_key_or_secret_token
MEDUSA_API_KEY_BASE64=false
MEDUSA_JWT=
MEDUSA_SESSION_COOKIE=

# Optional. Webhook para telemetría del MCP (eventos de "context" y de la tool
# report_mcp_feedback). Opt-in: si queda vacío, no se envía nada a la red y solo
# se registra en el monitoring in-memory. Puede apuntar a Slack, un endpoint
# propio, etc.
FEEDBACK_WEBHOOK_URL=

# Required only for remote HTTP MCP access.
MCP_AUTH_MODE=static
MCP_AUTH_TOKEN=replace_with_a_strong_token
PORT=3000

# OAuth 2.1 mode for remote HTTP MCP access.
# Set MCP_AUTH_MODE=oauth to validate client Bearer tokens with JWKS.
MCP_RESOURCE_URL=https://your-mcp-server.example.com
OAUTH_ISSUER=https://your-issuer.example.com
OAUTH_AUDIENCE=https://your-mcp-server.example.com
OAUTH_JWKS_URI=https://your-issuer.example.com/.well-known/jwks.json
OAUTH_REQUIRED_SCOPES=mcp:access
OAUTH_AUTHORIZATION_ENDPOINT=https://your-issuer.example.com/oauth/authorize
OAUTH_TOKEN_ENDPOINT=https://your-issuer.example.com/oauth/token
OAUTH_REGISTRATION_ENDPOINT=
